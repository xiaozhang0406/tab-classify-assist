{
  "manifest_version": 3,
  "name": "IceCola Tab Grouper",
  "version": "2.1.0",
  "description": "自动按域名整理你的标签页，一键分组 + 会话持久化，再也不怕误关丢失。",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "idle"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "IceCola Tab Grouper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "group-now": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "立即按域名分组标签页"
    },
    "dedup-now": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "立即去重关闭多余标签"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

