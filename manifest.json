{
  "manifest_version": 3,
  "name": "IceCola Tab Grouper",
  "version": "1.2.0",
  "description": "自动按域名整理你的标签页，一键分组 + 会话持久化，再也不怕误关丢失。",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "idle"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "IceCola Tab Grouper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
